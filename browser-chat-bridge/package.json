{
  "name": "browser-chat-provider-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Native Electron bridge between Browser Chat Provider and browser-based AI chat sessions.",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "npm run build:content && npm run build:network",
    "build:content": "esbuild src/content/content-script.js --bundle --format=iife --platform=browser --target=chrome120 --outfile=dist/content-script.js",
    "build:network": "esbuild src/providers/chatgpt/network-interceptor.js --bundle --format=iife --platform=browser --target=chrome120 --outfile=dist/network-interceptor.js",
    "electron": "electron .",
    "dev": "electron .",
    "watch": "esbuild src/content/content-script.js src/providers/chatgpt/network-interceptor.js --bundle --format=iife --platform=browser --target=chrome120 --outdir=dist --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.4.2",
    "esbuild": "^0.25.0",
    "wait-on": "^9.1.0"
  }
}
